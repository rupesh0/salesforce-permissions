<?xml version="1.0" encoding="UTF-8" ?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>59.0</apiVersion>
    <isExposed>true</isExposed>
    <masterLabel>Permission Container</masterLabel>
    <description
  >Top-level wrapper component for permission pages with common toolbar and filters.</description>
    <targets>
        <target>lightning__AppPage</target>
        <target>lightning__RecordPage</target>
        <target>lightning__HomePage</target>
    </targets>
    <targetConfigs>
        <targetConfig
      targets="lightning__AppPage,lightning__HomePage,lightning__RecordPage"
    >
            <property
        name="permissionType"
        type="String"
        default="objects"
        label="Permission Type"
        datasource="objects,apexClass,vfPage,customSettings,customMetadata,externalDataSources,flow,namedCredentials,assignedApps,assignedConnectedApps,appPermissions,systemPermissions,orgWideEmail,standardInvocableActions,serviceProviders"
      />
            <property name="title" type="String" label="Custom Page Title" />
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>
